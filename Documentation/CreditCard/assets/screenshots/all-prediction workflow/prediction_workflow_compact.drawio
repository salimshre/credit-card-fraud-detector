<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Prediction Workflow (Compact)" id="compactFlow01">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="335" y="10" width="110" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Receive Transaction&#10;POST /predict or /api/upload-csv" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="290" y="75" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="Parse &amp; Sanitize&#10;parse_transaction() — required fields, amount, date/time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="150" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="310" y="225" width="160" height="65" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="HTTP 400&#10;Error Response" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="Load Behavior Profile &amp; Analyze Signals&#10;get_behavior_profile() + analyze_behavior()&#10;new_device +10, new_country +12, 3x-avg +14, night +6, amount&#8805;1000 +10, new_customer +4, new_category +6, rapid txn +8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="255" y="315" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Feature Engineering &amp; Scaling&#10;engineer_single_transaction() — 15 features (Time4+Amount2+Categorical3+Behavioral6)&#10;scaler.transform() — zero mean, unit variance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="255" y="420" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="ML Inference &amp; Threshold&#10;model.predict_proba() — RF, 200 trees, fraud_model.pkl&#10;prediction = 1 if probability &#8805; THRESHOLD (F2-optimized) else 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="255" y="510" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="Calculate Base Risk Score (0-100)&#10;score = prob&#215;0.72 + flag(+10 if pred=1) + min(behavior_points,28)&#10;Low&lt;35 | Medium 35-64 | High 65-84 | Critical&#8805;85" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="255" y="600" width="270" height="65" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="Apply Business Rules&#10;(amount&#8805;300k? amount&#8805;100k? pred=1? behavior_points&#8805;20?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="290" y="695" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="Blocked / Fraud / Review Required&#10;risk_score floored to 65-100&#10;status = Pending Review / Blocked" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="540" y="705" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="Normal&#10;status = Auto Cleared" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="705" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n13" value="Alert needed?&#10;(pred=1 OR risk_score&#8805;65)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="290" y="825" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n14" value="Create Alert&#10;alert_service — severity, message, risk_score" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="835" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n15" value="Update Profile &amp; Persist&#10;update_behavior_profile() (if not Blocked) + save_state() &#8594; data_store.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="940" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n16" value="Return Response&#10;label + probability + risk_score + behavior" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="1045" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
